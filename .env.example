# Required: get a bot token from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
# Free recognition on the same server. No transcription API key needed.
WHISPER_MODEL=tiny
WHISPER_LANGUAGE=ru
WHISPER_CPU_THREADS=1
MODEL_CACHE_DIR=.models
# Set 1 after downloading the model to prohibit model downloads at startup.
MODEL_OFFLINE=0
# Empty = anyone can use the bot in private chats.
# To restrict access, set Telegram user IDs separated by commas.
ALLOWED_USER_IDS=
MAX_DURATION_SECONDS=300
# One recording at a time. Queue includes the running recording.
MAX_PENDING_JOBS=10
MAX_PENDING_PER_USER=3

# polling = local computer / VPS; webhook = Render or another HTTPS host
RUN_MODE=polling
# In Render this is automatically read from RENDER_EXTERNAL_URL.
PUBLIC_URL=
# Required only in webhook mode. Generate a random value; never use the bot token.
WEBHOOK_SECRET=
PORT=10000
